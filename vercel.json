{
  "buildCommand": "npm run vercel-build",
  "headers": [
    {
      "source": "/audio/order-call/numbers/v2/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/payment-watchdog",
      "schedule": "0 0 * * *"
    }
  ]
}
