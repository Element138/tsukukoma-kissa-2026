generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ActorType {
  POS
  KITCHEN
  WAITER
  MENU_DISPLAY
  ORDER_DISPLAY
  ADMIN
}

enum Availability {
  AVAILABLE
  INCREASED_WAIT
  PAUSED
  SOLD_OUT
}

enum FulfillmentType {
  DINE_IN
  TAKEOUT
}

enum PaymentMethod {
  CASH
  SQUARE
  PAYMENT_SKIPPED
}

enum PaymentStatus {
  PAID
  FAILED
  AWAITING
  CANCELED
  SKIPPED
}

enum OrderStatus {
  PENDING
  PREPARING
  AWAITING_SERVING
  COMPLETED
  FAILED
  CANCELED
}

enum OrderItemStatus {
  QUEUED
  READY
  SERVED
  CANCELED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum UndoOperationType {
  ITEM_READY
  ITEM_READY_BATCH
  ITEM_SERVED
  TAKEOUT_ORDER_SERVED
}

enum PaymentSkipReasonType {
  TEST
  DEVICE_ERROR
  NETWORK_ERROR
  OTHER
}

enum PaymentIncidentType {
  LATE_SUCCESS_AFTER_FAILED
  SQUARE_RESULT_MISSING
}

model Actor {
  id                  String                  @id @db.VarChar(64)
  actorType           ActorType
  label               String                  @db.VarChar(120)
  secretHash          String
  isActive            Boolean                 @default(true)
  kitchenEnabled      Boolean                 @default(true)
  kitchenDisplayOrder Int                     @default(0)
  sessionVersion      Int                     @default(0)
  lastSeenAt          DateTime?
  online              Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  createdOrders       Order[]                 @relation("OrderCreatedBy")
  servedItems         OrderItem[]             @relation("OrderItemServedBy")
  kitchenAssignments  MenuKitchenAssignment[] @relation("KitchenActorAssignments")
  kitchenOrderItems   OrderItem[]             @relation("KitchenActorOrderItems")
  undoOperations      UndoOperation[]
  auditLogs           AuditLog[]              @relation("AuditActor")
  dismissedPaymentIncidents PaymentIncident[] @relation("PaymentIncidentDismissedBy")

  @@index([actorType])
  @@index([actorType, isActive, kitchenEnabled])
  @@index([kitchenDisplayOrder])
}

model Session {
  sessionId      String   @id @default(cuid())
  actorId        String   @db.VarChar(64)
  tokenHash      String   @unique
  issuedAt       DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  actor          Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([expiresAt])
}

model MenuCategory {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(120)
  customBadgeText String? @db.VarChar(32)
  customBadgeColor String? @db.VarChar(16)
  displayOrder Int?     @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  menus        Menu[]
}

model Menu {
  id              String                  @id @default(uuid())
  name            String                  @db.VarChar(120)
  shortName       String?                 @db.VarChar(120)
  priceJpy        Int
  availability    Availability            @default(AVAILABLE)
  workloadSeconds Float
  dailyOrderCap   Int?
  lowStockBadgeEnabled Boolean            @default(false)
  lowStockBadgeThreshold Int              @default(0)
  displayOrder    Int?                    @default(0)
  coverImageDataUrl String?
  allergensJson   Json                    @default("[]")
  allergenDisplayEnabled Boolean          @default(true)
  customBadgeText String?                 @db.VarChar(32)
  customBadgeColor String?                @db.VarChar(16)
  categoryId      String
  isActive        Boolean                 @default(true)
  showLeadTime    Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  category        MenuCategory            @relation(fields: [categoryId], references: [id])
  assignments     MenuKitchenAssignment[]
  orderItems      OrderItem[]
  dailyCounts     MenuDailyCount[]
  stock           MenuStock?
  capReservations OrderMenuCapReservation[]

  @@index([categoryId])
  @@index([availability, isActive])
}

model MenuKitchenAssignment {
  menuId      String
  kitchenId   String   @db.VarChar(64)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  kitchenActor Actor   @relation("KitchenActorAssignments", fields: [kitchenId], references: [id], onDelete: Cascade)

  @@id([menuId, kitchenId])
  @@index([kitchenId, enabled])
}

model MenuCoverImage {
  id        String   @id @db.VarChar(64)
  bytes     Bytes
  createdAt DateTime @default(now())
}

model MenuDailyCount {
  menuId     String
  jstDate    String   @db.VarChar(10)
  count      Int      @default(0)
  cookedCount Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([menuId, jstDate])
  @@index([jstDate])
}

model Order {
  id                     String                @id @default(cuid())
  orderNo                Int                   @unique @default(autoincrement())
  createdAt              DateTime              @default(now())
  createdByActorId       String                @db.VarChar(64)
  idempotencyKey         String?               @unique
  confirmedAt            DateTime?
  lastCalledAt           DateTime?
  calls                  OrderCall[]
  canceledAt             DateTime?
  fulfillmentType        FulfillmentType
  tableNo                Int?
  partySize              Int
  ageRangesJson          Json
  specialNote            String?
  excludeFromWaitStats   Boolean               @default(false)
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus
  events                 Json
  paymentSkipReasonType  PaymentSkipReasonType?
  paymentSkipReasonText  String?
  orderStatus            OrderStatus
  totalPriceJpy          Int
  squareTransactionId    String?
  paymentAwaitDeadlineAt DateTime?
  autoCancelDeadlineAt   DateTime?
  lastMutationVersion    Int                   @default(0)
  createdBy              Actor                 @relation("OrderCreatedBy", fields: [createdByActorId], references: [id])
  items                  OrderItem[]
  auditLogs              AuditLog[]
  paymentIncidents       PaymentIncident[]
  squareAttempt          SquarePaymentAttempt?
  capReservations        OrderMenuCapReservation[]
  cashierPhoto           CashierPhoto?

  @@index([createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, paymentAwaitDeadlineAt])
  @@index([createdByActorId])
}

model OrderMenuCapReservation {
  orderId String
  menuId String
  jstDate String @db.VarChar(10)
  quantity Int
  releasedAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  @@id([orderId, menuId])
  @@index([menuId, jstDate, releasedAt])
}

model SquarePaymentAttempt {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stateToken String @unique
  appId String
  locationId String
  callbackUrl String
  createdAt DateTime @default(now())
  launchedAt DateTime?
  callbackJson Json?
  transactionId String? @unique
  resolvedAt DateTime?
  lastError String?
  verifyAttempts Int @default(0)
  verifyAfter DateTime?
}

model MenuStock {
  menuId String @id
  readyCount Int @default(0)
  stockResetAt DateTime @default(now())
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

model OrderCall {
  id Int @id @default(autoincrement())
  orderId String
  calledAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, calledAt])
}

model OrderItem {
  id                      String          @id @default(uuid())
  orderId                 String
  menuId                  String
  itemNameSnapshot        String
  unitPriceJpy            Int
  workloadSecondsSnapshot Float
  kitchenId               String?         @db.VarChar(64)
  kitchenAssignedAt       DateTime?
  status                  OrderItemStatus
  readyAt                 DateTime?
  servedAt                DateTime?
  servedByActorId         String?         @db.VarChar(64)
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu                    Menu            @relation(fields: [menuId], references: [id])
  kitchenActor            Actor?          @relation("KitchenActorOrderItems", fields: [kitchenId], references: [id], onDelete: SetNull)
  servedBy                Actor?          @relation("OrderItemServedBy", fields: [servedByActorId], references: [id])

  @@index([orderId, status])
  @@index([kitchenId, status])
  @@index([readyAt])
}

model UndoOperation {
  id                   String            @id @default(cuid())
  actorId              String            @db.VarChar(64)
  operationType        UndoOperationType
  targetEntityType     String            @db.VarChar(64)
  targetEntityId       String            @db.VarChar(120)
  orderId              String?
  expectedOrderVersion Int
  payload              Json
  createdAt            DateTime          @default(now())
  actor                Actor             @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([orderId])
}

model AuditLog {
  id            String      @id @default(cuid())
  timestamp     DateTime    @default(now())
  actorId       String?     @db.VarChar(64)
  actorType     ActorType?
  actionType    String      @db.VarChar(64)
  entityType    String      @db.VarChar(64)
  entityId      String      @db.VarChar(120)
  orderId       String?
  beforeJson    Json?
  afterJson     Json?
  reasonType    String?
  reasonText    String?
  result        AuditResult
  correlationId String?
  prevHash      String?
  hash          String?
  actor         Actor?      @relation("AuditActor", fields: [actorId], references: [id])
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([actionType, timestamp])
  @@index([actorType, actorId, timestamp])
  @@index([result, timestamp])
  @@index([orderId, timestamp])
}

model RealtimeEvent {
  id        Int      @id @default(autoincrement())
  channel   String   @db.VarChar(80)
  eventType String   @db.VarChar(32)
  payload   Json
  createdAt DateTime @default(now())

  @@index([channel, id])
  @@index([createdAt])
}

model AppSetting {
  id                            Int      @id
  menuDisplayPageSeconds        Int      @default(18)
  orderDisplayMarqueeText       String   @default("") @db.VarChar(240)
  orderDisplayMarqueeSpeedSeconds Int    @default(24)
  orderCallVolume               Float    @default(0.8)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model CashierPhoto {
  id              String    @id @default(uuid())
  checkoutKey     String    @unique @db.VarChar(128)
  actorId         String    @db.VarChar(64)
  sessionId       String
  requestedAt     DateTime  @default(now())
  capturedAt      DateTime?
  storedAt        DateTime?
  objectPath      String?   @unique
  sha256          String?   @db.VarChar(64)
  byteSize        Int?
  failureCode     String?   @db.VarChar(64)
  waivedAt        DateTime?
  orderId         String?   @unique
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([actorId, requestedAt])
}

model PhotoStorageState {
  id                Int       @id @default(1)
  failedAt          DateTime?
  failureCode       String?   @db.VarChar(64)
  ignoreUntil       DateTime?
}

model PaymentIncident {
  id                String              @id @default(cuid())
  orderId           String
  incidentType      PaymentIncidentType
  messageJa         String              @db.VarChar(400)
  detailsJson       Json?
  createdAt         DateTime            @default(now())
  dismissedAt       DateTime?
  dismissedByActorId String?            @db.VarChar(64)
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dismissedBy       Actor?              @relation("PaymentIncidentDismissedBy", fields: [dismissedByActorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([dismissedAt, createdAt])
}
